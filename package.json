{
  "name": "opsrun",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "node scripts/local.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/base-local.mjs && supabase test db",
    "db:start": "supabase start && node scripts/base-local.mjs",
    "db:prepare": "node scripts/base-local.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/base-local.mjs",
    "imagen": "bash scripts/servidor/opsrun.sh construir",
    "deploy:servidor": "bash scripts/servidor/opsrun.sh deploy",
    "deploy:vuelta-atras": "bash scripts/servidor/opsrun.sh vuelta-atras",
    "deploy:estado": "bash scripts/servidor/opsrun.sh estado",
    "test:deploy": "bash scripts/servidor/prueba-ciclo.sh"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "supabase": "2.122.1",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
